# ----------------------------
# Core Python ignores
# ----------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually includes scripts and .spec files
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
*.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_out.json

# IPython
profile_default/
ipython_config.py

# pyenv / Poetry / PDM / Hatch
.python-version
poetry.lock
pdm.lock
.hatch/

# mypy / pytype / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
pyrightconfig.json

# pyre / static type checking
.pyre/

# Django / Flask / FastAPI stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
*.db
*.sqlite3

# Scrapy
.scrapy

# Sphinx documentation
docs/_build/
doc/_build/
build/doctrees/
build/html/

# PyBuilder
target/

# Jupyter Notebook metadata
.ipynb_checkpoints/

# Editor settings / IDE configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS / Windows / Linux system files
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings for virtualenv
.vscode/settings.json

# Logs and temp files
*.log
*.tmp
*.bak
*.swp
*~

# dotenv environment variables
.env.local
.env.dev
.env.prod
.env.test
.envrc
.env.*

# Celery beat schedule
celerybeat-schedule

# Pyre type checker
.pyre/

# Black, isort, Ruff caches
.black/
.isort/
.ruff_cache/

# Local development extras
*.secret
secrets.json
credentials.json

# ----------------------------
# End of Python .gitignore
# ----------------------------
